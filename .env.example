# ==========================================================================
# Pagoda Travel — environment
#
# Copy to .env and fill in. Next.js also reads .env.local, which takes
# precedence over .env — an empty value there will shadow a real one here,
# so keep overrides out of .env.local unless you mean them.
#
# Never commit a filled-in copy: .env and .env.local are gitignored, this
# file is not.
#
# Required to boot ....... Supabase, app URL
# Required to send mail .. Resend or SMTP
# Everything else degrades: the feature is off, not broken.
# ==========================================================================

# --------------------------------------------------------------------------
# Core
# --------------------------------------------------------------------------
# Public origin, no trailing slash. Used in every email link and OAuth
# redirect, so a wrong value sends guides and advisors to the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Supabase — required
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. Bypasses row-level security, so it must never reach the
# browser or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --------------------------------------------------------------------------
# Sessions
# --------------------------------------------------------------------------
# HMAC key for the signed session cookie. Falls back to
# SUPABASE_SERVICE_ROLE_KEY when unset — which means rotating the service key
# silently signs every user out. Set this explicitly so the two can move
# independently. Any long random string; `openssl rand -base64 48`.
AUTH_SESSION_SECRET=

# --------------------------------------------------------------------------
# Email
#
# EMAIL_PROVIDER picks the primary transport. "resend" puts Resend in front
# with SMTP behind it: quota, 5xx, network failures and an unverified sending
# domain fall through to SMTP, so mail keeps flowing. A bad API key or a
# malformed recipient does not fall through — SMTP would fail identically.
# Unset or "smtp" uses SMTP only, which is the escape hatch if delivery ever
# looks wrong: change this one value and redeploy, no code change.
#
# Keep SMTP configured even on "resend" — an unconfigured fallback is not a
# fallback.
# --------------------------------------------------------------------------
EMAIL_PROVIDER=resend

# Resend — https://resend.com/api-keys
# Create the key send-only and domain-restricted. Its value cannot be viewed
# again after creation.
RESEND_API_KEY=re_...
# Must be on a domain verified in Resend, which is not necessarily the same
# domain as SMTP_FROM. Each provider sends from a domain it is authorised for.
RESEND_FROM_EMAIL=Pagoda Travel <hello@app-pagoda.org>

# SMTP — the fallback, and the default until EMAIL_PROVIDER=resend.
# SMTP_HOST tolerates a protocol prefix and trailing slash; both are stripped.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=hello@example.com
SMTP_PASS=
SMTP_FROM=hello@example.com
# Optional alias for SMTP_FROM; takes precedence when both are set.
FROM_EMAIL=

# --------------------------------------------------------------------------
# Scheduled jobs
# --------------------------------------------------------------------------
# Shared secret for /api/jobs/release-notifications, no-applicant-alerts and
# sync-board-visibility. These paths are reachable without a user session, so
# this secret is the only thing in front of them — one of them emails guides.
# They refuse to run (503) while it is unset, which is deliberate.
# The caller sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --------------------------------------------------------------------------
# reCAPTCHA — signup abuse protection
#
# Optional in development: verification is skipped when the secret is unset.
# In production a missing secret fails the check closed, so signup breaks.
# --------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --------------------------------------------------------------------------
# Google OAuth — calendar and Meet links
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Only needed when Meet link creation uses a different callback.
GOOGLE_MEET_REDIRECT_URI=

# --------------------------------------------------------------------------
# Transferz — airport transfers
#
# TRANSFERZ_ENV picks the gateway: staging (default), or production/prod/live.
# The gateway and Warp Drive URLs must both point at the same tier; the app
# refuses to start a booking if they disagree.
# --------------------------------------------------------------------------
TRANSFERZ_ENV=staging
TRANSFERZ_EMAIL=
TRANSFERZ_PASSWORD=
TRANSFERZ_API_KEY=
# Optional. Override the URLs TRANSFERZ_ENV would choose.
TRANSFERZ_GATEWAY_BASE_URL=
TRANSFERZ_WARP_DRIVE_BASE_URL=
# Optional. Only when Transferz issued a numeric partner id.
TRANSFERZ_PARTNER_ID=
# Optional ISO 4217 code for quotes. Defaults to JPY.
TRANSFERZ_QUOTE_CURRENCY=JPY

# --------------------------------------------------------------------------
# WhatsApp Cloud API — mirrors chat messages to guides who use WhatsApp
# Optional: the mirror is skipped entirely when unset.
# --------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Your own string; must match what you enter in the Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=
